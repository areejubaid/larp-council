# Copy to .env (git-ignored, read automatically). Without a key the Brain runs in offline mode.

# Option 1: Anthropic
ANTHROPIC_API_KEY=
BRAIN_MODEL=claude-sonnet-5-5

# Option 2: Featherless (free hackathon credits). Pick a model id from featherless.ai/models.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Optional: force one provider (anthropic or featherless). Default: Anthropic if its key is set.
BRAIN_PROVIDER=

# Optional: where to POST events (Part C Event Hub), e.g. http://localhost:8080/events
EVENT_HUB_URL=
